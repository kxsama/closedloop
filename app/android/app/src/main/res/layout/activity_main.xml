<?xml version="1.0" encoding="utf-8"?>
<!--
  首页（v0.9）。
  信息顺序即优先级：今天还剩什么 → 有没有东西要处理 → 各计划详情 → 复盘。
  打开应用第一眼要能回答"现在什么情况"，而不是先看到一堆卡片再自己拼。
-->
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:fillViewport="true">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:paddingLeft="18dp"
        android:paddingTop="16dp"
        android:paddingRight="18dp"
        android:paddingBottom="24dp">

        <!-- ===== 顶栏 ===== -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="闭环"
                android:textColor="#1F1E1B"
                android:textSize="22sp"
                android:textStyle="bold" />

            <Space
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1" />

            <TextView
                android:id="@+id/dateView"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:textColor="#6B6A66"
                android:textSize="12sp" />

            <TextView
                android:id="@+id/btnUpdate"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:paddingStart="12dp"
                android:text="检查更新"
                android:textColor="#177A50"
                android:textSize="12sp"
                android:textStyle="bold" />
        </LinearLayout>

        <!-- ===== 一句话现状：这一屏最重要的东西 ===== -->
        <TextView
            android:id="@+id/headline"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="14dp"
            android:lineSpacingMultiplier="1.35"
            android:textColor="#1F1E1B"
            android:textSize="19sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/subline"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="6dp"
            android:lineSpacingMultiplier="1.4"
            android:textColor="#6B6A66"
            android:textSize="11sp" />

        <!-- ===== 待处理提示条（有才显示） ===== -->
        <TextView
            android:id="@+id/banner"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:background="@drawable/bg_banner"
            android:padding="13dp"
            android:textColor="#8A5A00"
            android:textSize="12sp"
            android:visibility="gone" />

        <!-- ===== 计划卡片 ===== -->
        <LinearLayout
            android:id="@+id/plansContainer"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="14dp"
            android:orientation="vertical" />

        <Button
            android:id="@+id/btnNew"
            android:layout_width="match_parent"
            android:layout_height="48dp"
            android:layout_marginTop="4dp"
            android:backgroundTint="#22A06B"
            android:text="＋ 新建一个计划"
            android:textColor="#FFFFFF"
            android:textSize="13sp"
            android:textStyle="bold" />

        <!-- 今天没安排、但别处有计划时，这里是找回它们的入口 -->
        <TextView
            android:id="@+id/allPlans"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="14dp"
            android:gravity="center"
            android:padding="8dp"
            android:textColor="#6B6A66"
            android:textSize="11sp" />

        <!-- ===== 复盘：默认收起，点开才看 ===== -->
        <LinearLayout
            android:id="@+id/reviewHead"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:paddingTop="8dp"
            android:paddingBottom="8dp">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="当日复盘"
                android:textColor="#1F1E1B"
                android:textSize="12sp"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/reviewSummary"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:paddingStart="10dp"
                android:textColor="#6B6A66"
                android:textSize="11sp" />

            <TextView
                android:id="@+id/reviewToggle"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="展开"
                android:textColor="#177A50"
                android:textSize="11sp"
                android:textStyle="bold" />
        </LinearLayout>

        <TextView
            android:id="@+id/review"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:background="@drawable/bg_card"
            android:lineSpacingMultiplier="1.55"
            android:padding="16dp"
            android:textColor="#6B6A66"
            android:textSize="11sp"
            android:visibility="gone" />
    </LinearLayout>
</ScrollView>
