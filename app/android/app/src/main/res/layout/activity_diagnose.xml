<?xml version="1.0" encoding="utf-8"?>
<!-- 体检页（v0.9）：5 项系统设置，逐项实时回读、逐项可跳转。 -->
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:fillViewport="true">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="20dp">

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="开始之前"
            android:textColor="#1F1E1B"
            android:textSize="22sp"
            android:textStyle="bold" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:lineSpacingMultiplier="1.5"
            android:text="它靠 5 项系统设置干活。全部打开，它才是那个会验收你的应用；少一项，它可能安静地什么都不做——而你不会收到任何提示。"
            android:textColor="#6B6A66"
            android:textSize="12sp" />

        <TextView
            android:id="@+id/diagSummary"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="18dp"
            android:textColor="#22A06B"
            android:textSize="13sp"
            android:textStyle="bold" />

        <LinearLayout
            android:id="@+id/diagList"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:orientation="vertical" />

        <Button
            android:id="@+id/btnRecheck"
            android:layout_width="match_parent"
            android:layout_height="44dp"
            android:layout_marginTop="16dp"
            android:background="@drawable/bg_btn_outline"
            android:text="重新检查"
            android:textColor="#1F1E1B"
            android:textSize="13sp" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="18dp"
            android:lineSpacingMultiplier="1.5"
            android:text="这些设置随时能改回来。使用数据只留在本机，没有账号、不上传。"
            android:textColor="#B4B2A9"
            android:textSize="10sp" />
    </LinearLayout>
</ScrollView>
